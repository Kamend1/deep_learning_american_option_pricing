        2.0,
        4.0
      ]
    },
    {
      "name": "deep_in_the_money",
      "moneyness": [
        0.25,
        0.5
      ]
    },
    {
      "name": "deep_out_of_the_money",
      "moneyness": [
        1.5,
        2.0
      ]
    },
    {
      "name": "high_interest_rate",
      "risk_free_rate": [
        0.1,
        0.2
      ]
    },
    {
      "name": "high_dividend_yield",
      "dividend_yield": [
        0.08,
        0.15
      ]
    }
  ],
  "notes": [
