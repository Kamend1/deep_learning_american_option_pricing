def integrated_config_from_dict(raw):
    values = dict(raw)
    tuple_fields = (
        "shared_hidden_sizes",
        "batch_norm_after",
        "residual_head_sizes",
        "direct_head_sizes",
        "continuation_head_sizes",
        "exercise_head_sizes",
    )
    for field in tuple_fields:
        if field in values:
            values[field] = tuple(values[field])
    return IntegratedMultiHeadConfig(**values)


