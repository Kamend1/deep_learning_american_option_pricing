def weighted_ood_metric(
    frame,
    column,
):
    values = pd.to_numeric(
        frame[column],
        errors="coerce",
    )
    if "observations" in frame.columns:
        weights = pd.to_numeric(
            frame["observations"],
            errors="coerce",
        )
        valid = (
            values.notna()
            & weights.notna()
            & (weights > 0)
        )
        if valid.any():
            return float(
                np.average(
                    values[valid],
                    weights=weights[valid],
                )
            )
    return float(values.mean())

