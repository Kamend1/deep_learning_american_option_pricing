    plt.title(f"Pilot Distribution: {column.replace('_', ' ').title()}")
    plt.grid(alpha=0.20)
    plt.show()


plt.figure(figsize=(10, 6))
scatter = plt.scatter(
    pilot["moneyness"],
    pilot["time_to_maturity"],
    c=pilot["volatility"],
    s=14,
    alpha=0.70,
)
plt.colorbar(scatter, label="Volatility")
plt.xlabel("Spot / Strike")
plt.ylabel("Time to Maturity")
plt.title("Joint Pilot Coverage by Moneyness, Maturity, and Volatility")
plt.grid(alpha=0.20)
plt.show()





target_columns = [
    "european_price",
    "american_price",
    "early_exercise_premium",
    "normalized_american_price",
    "normalized_early_exercise_premium",
]

pilot[target_columns].describe(percentiles=[0.01, 0.05, 0.25, 0.50, 0.75, 0.95, 0.99]).T


baseline_error = pilot["american_price"] - pilot["european_price"]

black_scholes_proxy_metrics = pd.Series(
    {
        "MAE": float(np.mean(np.abs(baseline_error))),
        "RMSE": float(np.sqrt(np.mean(np.square(baseline_error)))),
        "Median absolute error": float(np.median(np.abs(baseline_error))),
        "Maximum absolute error": float(np.max(np.abs(baseline_error))),
        "Normalized MAE": float(
            np.mean(np.abs(pilot["normalized_early_exercise_premium"]))
        ),
        "Zero-premium share (<= 1e-8)": float(
            (pilot["early_exercise_premium"] <= 1e-8).mean()
        ),
    },
    name="Black–Scholes proxy baseline",
)

black_scholes_proxy_metrics.to_frame()


plt.figure(figsize=(10, 5))
plt.hist(pilot["early_exercise_premium"], bins=40)
plt.xlabel("Early-Exercise Premium")
plt.ylabel("Observations")
plt.title("Distribution of the American Early-Exercise Premium")
plt.grid(alpha=0.20)
plt.show()








pilot = pilot.copy()
pilot["exercise_gap"] = pilot["intrinsic_value"] - pilot["continuation_value"]
pilot["normalized_exercise_gap"] = pilot["exercise_gap"] / pilot["strike"]
pilot["absolute_normalized_exercise_gap"] = pilot["normalized_exercise_gap"].abs()

exercise_summary = (
    pilot.groupby("exercise_now", as_index=False)
    .agg(
        observations=("sample_id", "count"),
        mean_moneyness=("moneyness", "mean"),
        mean_maturity=("time_to_maturity", "mean"),
        mean_volatility=("volatility", "mean"),
        mean_rate=("risk_free_rate", "mean"),
        mean_dividend=("dividend_yield", "mean"),
        mean_premium=("early_exercise_premium", "mean"),
    )
)
exercise_summary["share"] = exercise_summary["observations"] / len(pilot)
exercise_summary


fig_data = pilot.sort_values(["time_to_maturity", "moneyness"])

plt.figure(figsize=(10, 6))
scatter = plt.scatter(
    fig_data["time_to_maturity"],
    fig_data["moneyness"],
    c=fig_data["exercise_now"].astype(int),
    s=16,
    alpha=0.70,
)
plt.colorbar(scatter, ticks=[0, 1], label="Exercise Now")
plt.xlabel("Time to Maturity")
plt.ylabel("Spot / Strike")
plt.title("Pilot Exercise and Continuation Regions")
plt.grid(alpha=0.20)
plt.show()


BOUNDARY_GAP_THRESHOLD = 0.01
boundary_candidates = pilot.loc[
    pilot["absolute_normalized_exercise_gap"] <= BOUNDARY_GAP_THRESHOLD
].copy()

pd.Series(
    {
        "Boundary threshold": BOUNDARY_GAP_THRESHOLD,
        "Boundary candidates": len(boundary_candidates),
        "Boundary candidate share": len(boundary_candidates) / len(pilot),
        "Exercise share among boundary candidates": (
            boundary_candidates["exercise_now"].mean()
            if len(boundary_candidates)
            else np.nan
        ),
    },
    name="Boundary coverage",
).to_frame()








split_config = SplitConfig(
    train_fraction=0.70,
    validation_fraction=0.15,
    test_fraction=0.15,
    seed=RANDOM_SEED,
    stratify_column="exercise_now",
)

pilot_splits = create_train_validation_test_split(
    pilot,
    config=split_config,
)

split_summary = pd.DataFrame(
    {
        "split": list(pilot_splits),
        "observations": [len(frame) for frame in pilot_splits.values()],
        "exercise_rate": [
            frame["exercise_now"].mean() for frame in pilot_splits.values()
        ],
        "mean_normalized_premium": [
            frame["normalized_early_exercise_premium"].mean()
            for frame in pilot_splits.values()
        ],
    }
)
split_summary["share"] = split_summary["observations"] / len(pilot)
split_summary


validate_split_integrity(pilot_splits, config=split_config)


pilot_split_manifest = build_split_manifest(
    pilot_splits,
    config=split_config,
    dataset_name="american_put_pilot",
)

save_split_assignments(
    pilot_splits,
    PILOT_SPLIT_PATH,
    config=split_config,
)
save_split_manifest(
    pilot_split_manifest,
    PILOT_SPLIT_MANIFEST_PATH,
)

print(f"Saved split assignments: {PILOT_SPLIT_PATH}")
print(f"Saved split manifest:    {PILOT_SPLIT_MANIFEST_PATH}")





ood_design = pd.DataFrame(
    [
        {
            "name": spec.name,
            "description": spec.description,
            "ranges": dict(spec.ranges),
        }
        for spec in DEFAULT_OOD_SPECS
    ]
)
ood_design








production_config = ProductionDatasetConfig(
    core_observations=1_000_000,
    boundary_observations=250_000,
    ood_observations_per_set=50_000,
    tree_steps=250,
    strike=100.0,
    chunk_size=25_000,
    seed=RANDOM_SEED,
    train_fraction=split_config.train_fraction,
    validation_fraction=split_config.validation_fraction,
    test_fraction=split_config.test_fraction,
)

production_components = build_component_specs(production_config)

production_design = {
    "manifest_version": 1,
    "status": "approved_design_before_production_generation",
    "random_seed": production_config.seed,
    "total_observations": production_config.total_observations,
    "in_domain_observations": production_config.in_domain_observations,
    "ood_observations": production_config.ood_observations,
    "tree_steps": production_config.tree_steps,
    "chunk_size": production_config.chunk_size,
    "strike": production_config.strike,
    "components": [
        {
            "name": component.name,
            "planned_observations": component.observations,
            "start_id": component.start_id,
            "end_id": component.start_id + component.observations - 1,
            "purpose": component.purpose,
            "split_eligible": component.split_eligible,
            "parameter_ranges": {
                name: list(bounds)
                for name, bounds in asdict(component.ranges).items()
            },
        }
        for component in production_components
    ],
    "split": {
        "train": production_config.train_fraction,
        "validation": production_config.validation_fraction,
        "test": production_config.test_fraction,
        "seed": production_config.seed,
        "stratify_column": split_config.stratify_column,
    },
    "pilot_audit": {
        "pilot_source": pilot_source,
        "pilot_observations": len(pilot),
        "quality_checks_passed": quality_report.passed,
        "floor_repair_rate": float(
            quality_report.floor_summary.loc[0, "repair_rate"]
        ),
        "exercise_rate": float(pilot["exercise_now"].mean()),
        "boundary_candidate_share": float(
            len(boundary_candidates) / len(pilot)
        ),
        "black_scholes_proxy_mae": float(
            black_scholes_proxy_metrics["MAE"]
        ),
    },
}

assert production_design["total_observations"] == 1_450_000

DATASET_DESIGN_PATH.write_text(
    json.dumps(production_design, indent=2),
    encoding="utf-8",
)

print(f"Saved dataset design: {DATASET_DESIGN_PATH}")
print(
    f"Approved production observations: "
    f"{production_design['total_observations']:,}"
)








PRODUCTION_SCRIPT = (
    PROJECT_ROOT / "scripts" / "generate_production_dataset.py"
)
PRODUCTION_MANIFEST_PATH = (
    MANIFEST_DIR / "production_dataset_manifest.json"
)

# False: keep and skip existing component files.
# True: regenerate existing component files using --overwrite.
OVERWRITE_EXISTING_COMPONENTS = False

command = [
    sys.executable,
    str(PRODUCTION_SCRIPT),
    "--output-dir",
    str(DATA_DIR),
    "--manifest",
    str(PRODUCTION_MANIFEST_PATH),
    "--tree-steps",
    "250",
    "--chunk-size",
    "25000",
    "--seed",
    str(RANDOM_SEED),
]

if OVERWRITE_EXISTING_COMPONENTS:
    command.append("--overwrite")
    print("Overwrite enabled: existing production files will be regenerated.")
else:
    print("Overwrite disabled: existing production files will be kept and skipped.")

print("\nExecuting production generation script:\n")
print(" ".join(command))
print()

subprocess.run(
    command,
    cwd=PROJECT_ROOT,
    check=True,
)

expected_production_files = {
    "Core": DATA_DIR / "american_put_core.parquet",
    "Boundary": DATA_DIR / "american_put_boundary.parquet",
    "OOD high volatility": (
        DATA_DIR / "american_put_ood_high_volatility.parquet"
    ),
    "OOD extreme moneyness": (
        DATA_DIR / "american_put_ood_extreme_moneyness.parquet"
    ),
    "OOD long maturity": (
        DATA_DIR / "american_put_ood_long_maturity.parquet"
    ),
    "OOD rate/dividend": (
        DATA_DIR / "american_put_ood_rate_dividend.parquet"
    ),
}

production_status = pd.DataFrame(
    [
        {
            "Component": component,
            "File": path.name,
            "Exists": path.exists(),
            "Size (MB)": (
                path.stat().st_size / (1024**2)
                if path.exists()
                else np.nan
            ),
        }
        for component, path in expected_production_files.items()
    ]
)

display(production_status)

missing_files = [
    path
    for path in expected_production_files.values()
    if not path.exists()
]

if missing_files:
    missing_text = "\n".join(f"- {path}" for path in missing_files)
    raise FileNotFoundError(
        "Production generation is incomplete. Missing files:\n"
        f"{missing_text}"
    )

if not PRODUCTION_MANIFEST_PATH.exists():
    raise FileNotFoundError(
        "Production files exist, but the production manifest is missing:\n"
        f"{PRODUCTION_MANIFEST_PATH}"
    )

print("\nProduction dataset generation completed successfully.")
print(f"Manifest: {PRODUCTION_MANIFEST_PATH}")






