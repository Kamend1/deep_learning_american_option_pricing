def save_table(frame, path):
    """Save Parquet when available and fall back to CSV otherwise."""
    try:
        frame.to_parquet(path, index=False)
        return path
    except ImportError:
        fallback = path.with_suffix(".csv")
        frame.to_csv(fallback, index=False)
        return fallback


